# Supabase project (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Secret key, server only. Needed for uploads and deletes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket that holds the uploaded font files
SUPABASE_FONT_BUCKET=font-files

# Used for canonical URLs, sitemap and the Google redirect
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google accounts allowed to add, edit and delete fonts (comma separated).
# Leave empty to let any signed-in Google account manage the library.
ADMIN_EMAILS=you@example.com
